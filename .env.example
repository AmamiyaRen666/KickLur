# ── Telegram (wajib) ───────────────────────────────────────────────────────
TG_BOT_TOKEN=
TG_OWNER_CHAT_ID=

# Chat id tambahan yang boleh pakai bot, dipisah koma
TG_ALLOWED_IDS=

# ── Worker / concurrency ───────────────────────────────────────────────────
# Worker per run. Kick itu I/O bound (nunggu socket), bukan CPU bound.
BF_WORKERS=20
# Batas kick simultan TOTAL dari semua run sekaligus.
BF_MAX_CONCURRENCY=40
# Batas device per chat.
BF_MAX_DEVICES=2000

# Jeda antar kick per worker, detik. brutetolslhoya aslinya 0 (tanpa jeda);
# jeda nol bikin game server balas "GAME SERVER REFUSED" kalau dikencengin.
BF_KICK_DELAY=0.5

# Resolve nickname pemain (1 paket 11153 per device). 0 = matiin.
BF_LOOKUP=1

# ── Timeout (nilai asli brutetolslhoya dipertahankan) ──────────────────────
# Conn.open() di sumber = 5s
MLBB_OPEN_TIMEOUT=5
# Brute.kick() di sumber = 4.5s
MLBB_KICK_TIMEOUT=4.5
# Brute.fetch() di sumber = range(3)
MLBB_FETCH_ATTEMPTS=3

# ── Protokol MLBB (JANGAN diubah kecuali server gamenya berubah) ───────────
MLBB_LOGIN_HOST=login.ml.youngjoygame.com
MLBB_LOGIN_PORT=30021
MLBB_CLI_VER=2.1.97.1232.1
MLBB_CHANNEL=and_usa
MLBB_LANG=en

# ── Telegram pacing ────────────────────────────────────────────────────────
TG_MIN_INTERVAL=0.12
