# Copy to .env and fill in. Never commit the real .env.
#
# Bot token from @BotFather. The app refuses to boot without it.
TG_BOT_TOKEN=

# Chat id that owns the bot (only this chat may use it).
TG_OWNER_CHAT_ID=
# Optional extra chat ids allowed to use the bot, comma separated.
# TG_ALLOWED_IDS=

# ── Concurrency ─────────────────────────────────────────────────────────────
# One kick is ~0.017 ms of CPU (packet build + zstd) plus a few network round
# trips, so workers are I/O bound, not CPU bound. Past the game server's
# tolerance extra workers only cause throttling and retries.
#
# Railway guidance (1 vCPU / 512MB):
#   BF_WORKERS=20         is the sweet spot
#   10-15                 safer if you see "login server rejected"/timeouts
#   30-40                 ceiling worth trying on 2+ vCPU, watch the fail count
BF_WORKERS=20
# Hard ceiling on simultaneous kicks across ALL runs.
BF_MAX_CONCURRENCY=40
# Per-chat device list cap.
BF_MAX_DEVICES=2000

# ── Lookup nama akun ────────────────────────────────────────────────────────
# Tiap kick sekalian ambil nickname pemain (paket 11153) di koneksi yang sama,
# jadi status bisa nampilin account id + nama. Biayanya beberapa round trip
# tambahan per kick — dan nol kalau account-nya sudah di-cache.
# Set 0 kalau mau kick secepat mungkin tanpa lookup.
BF_LOOKUP=1

# ── Kecepatan kick ──────────────────────────────────────────────────────────
# Diukur langsung ke server game (2026-10):
#   TCP connect ke game server : ~189 ms
#   kirim paket kick           : ~0.2 ms
#   server balas ACK           : ~570 ms KEMUDIAN
#
# Server SELALU balas paket 10002. Kalau socket ditutup sebelum balasan itu
# datang, kernel kita jawab balasan itu dengan RST - bukan kelakuan client
# normal, dan itu satu-satunya beda nyata dari BF Kicker asli yang nendang.
#   kirim lalu tutup      : 0/25 dapat ACK
#   kirim lalu tunggu ACK : 25/25 dapat ACK
# Jadi default sekarang MENUNGGU. 0 = balik ke cara lama (lebih cepat, tanpa
# konfirmasi). 1.5 sudah lebih dari cukup (ACK datang ~570 ms).
BF_ACK_WAIT=1.5

# Kirim paket kick dua kali. Nulis paket cuma ~0.2 ms dibanding connect ~189 ms,
# jadi salinan kedua praktis gratis dan menutup kemungkinan frame pertama hilang.
BF_KICK_TWICE=0

# Kirim kick ke SEMUA game server yang diketahui untuk zone itu, paralel.
#
# Server login pakai load balancer dan kasih alamat game server BERBEDA tiap
# login (terukur: 10 alamat berbeda dari 12 login). Sesi pemain ada di salah
# satu alamat itu, jadi nembak ke satu alamat saja meleset ~90%.
# 10 server paralel = ~197 ms, sama seperti 1 server (connect-nya barengan).
# Set 0 kalau mau balik ke satu server saja.
BF_KICK_ALL_SERVERS=1

# Alamat game server awal, dipisah koma. Nggak wajib — tiap kick belajar satu
# alamat baru dan menyimpannya sendiri. Isi ini kalau mau langsung nembak semua.
# Contoh: MLBB_GS_SEED=185.23.183.11:10003,185.23.183.14:10003
MLBB_GS_SEED=

# ── Game protocol (defaults are the working values) ─────────────────────────
# MLBB_CLI_VER=2.2.16.1232.1
# MLBB_CHANNEL=and_usa
# MLBB_LOGIN_HOST=login.ml.youngjoygame.com
# MLBB_LOGIN_PORT=30021
# MLBB_PROFILE_ATTEMPTS=3
# MLBB_PROFILE_TIMEOUT=15

# ── Telegram pacing ─────────────────────────────────────────────────────────
# TG_MIN_INTERVAL=0.12
